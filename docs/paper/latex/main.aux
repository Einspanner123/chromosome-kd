\newlabel{prop:ot-gap}{{1}{4}{}{}{}}
\@writefile{lof}{\contentsline {figure}{\numberline {3}{\ignorespaces Entropy phase diagram. Conditional entropy $H(V \mid Z)$ as a function of the stochastic coupling parameter $\epsilon $. Hard OT ($\epsilon {=}0$) collapses to $H{=}0$; Random coupling ($\epsilon {\to }\infty $) saturates at $H{=}3.8415 \approx \log K{=}3.8427$ (relative error $0.03\%$). Stochastic coupling with $\epsilon \ge 1$ recovers near-full diversity, while $\epsilon < 1$ falls in the danger zone of diversity collapse.}}{4}{}\protected@file@percent }
\newlabel{fig:entropy-phase}{{3}{4}{}{}{}}
\@writefile{toc}{\contentsline {paragraph}{\numberline {\mbox  {III-C}0c}Empirical validation (Chromosome20240904).}{4}{}\protected@file@percent }
