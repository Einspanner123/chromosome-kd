\@writefile{lot}{\contentsline {table}{\numberline {V}{\ignorespaces Main ablation on Dataset~2 (independent inference, seed~42 for A0--A2; 3-seed mean for A3, std in text). NFE = total network forward evaluations per image. ``Last-30 std'' is within-run epoch \ensuremath  {\mathrm  {mAP}}{} std. \emph  {Question:} how much of the A0$\to $A1 gain is RF vs solver/step? \emph  {Conclusion:} RF dominates ($+0.077$, $94\%$); solver/step adds only $+0.005$ ($6\%$); Stoch.\ Coupling stabilizes without changing \ensuremath  {\mathrm  {mAP}}{}; DPM-Solver++ matches Heun at $1.71\times $ fewer NFE.}}{7}{}\protected@file@percent }
\newlabel{tab:main-ablation}{{V}{7}{}{}{}}
\@writefile{lot}{\contentsline {table}{\numberline {VI}{\ignorespaces SOTA comparison on Dataset~2 (independent inference; A3 reports 3-seed mean). LDMDet denotes our base detection framework. RTMDet-L uses a stronger CSPNeXt-L backbone; DINO R50 uses multi-scale deformable attention. Our method is competitive with RTMDet-L on overall \ensuremath  {\mathrm  {mAP}}{} while offering $1.71\times $ faster inference; AP$_S$ differences among top methods are not statistically significant (Table~\ref {tab:stat-tests}).}}{7}{}\protected@file@percent }
\newlabel{tab:sota}{{VI}{7}{}{}{}}
\@writefile{toc}{\contentsline {paragraph}{\numberline {\mbox  {IV-C}0c}Statistical significance of the ablation gains.}{7}{}\protected@file@percent }
\@writefile{lof}{\contentsline {figure}{\numberline {6}{\ignorespaces Per-class AP on the Dataset~2 validation set (A3 DPM-Solver++). Bars are colored by chromosome size group. The dashed line is the overall mean. Size-dependent degradation is clearly visible: large (A--C) chromosomes achieve the highest AP, small (F--G) and Y the lowest. The C-group (C6--C12) maintains high AP despite morphological similarity, and the Y chromosome is the hardest class due to compounded data scarcity and biological variability.}}{7}{}\protected@file@percent }
\newlabel{fig:per-class}{{6}{7}{}{}{}}
\@writefile{lot}{\contentsline {table}{\numberline {VII}{\ignorespaces Per-image paired significance tests on Dataset~2 validation ($n{=}500$ images; AP$_S$ uses the $60$ images containing small objects). $\Delta $ is the mean per-image difference of the second model minus the first. Wilc.\ = Wilcoxon signed-rank; $t$ = paired Student's $t$-test. *** denotes $p<0.001$; ns = not significant ($p>0.05$). \emph  {Question:} are the A2$-$A1 and A3$-$A2 gains significant per-image? \emph  {Conclusion:} Stoch.\ Coupling is not significant on Dataset~2 ($p{=}0.80$; its benefit is confined to Dataset~1, Table~\ref {tab:stat-tests-coupling}); DPM-Solver++ at matched 4-step is small but highly significant ($+0.006$, $p<10^{-6}$) --- slightly \emph  {better} than Heun; AP$_S$ differences are noise-equivalent.}}{8}{}\protected@file@percent }
\newlabel{tab:stat-tests}{{VII}{8}{}{}{}}
\@writefile{lot}{\contentsline {table}{\numberline {VIII}{\ignorespaces Per-image paired significance tests for the coupling ablation on Dataset~1 (pooled across $3$ training seeds, $n{=}440{\times }3{=}1320$; AP$_S$ uses $1314$ pairs after filtering images without small-object GT). $\Delta $ is the mean per-image difference of the second strategy minus the first. Wilc.\ = Wilcoxon signed-rank; $t$ = paired Student's $t$-test. *** denotes $p<0.001$; * denotes $p<0.05$.}}{8}{}\protected@file@percent }
\newlabel{tab:stat-tests-coupling}{{VIII}{8}{}{}{}}
\@writefile{toc}{\contentsline {subsection}{\numberline {\mbox  {IV-D}}Coupling Ablation}{8}{}\protected@file@percent }
\newlabel{sec:exp-coupling}{{\mbox  {IV-D}}{8}{}{}{}}
\@writefile{toc}{\contentsline {paragraph}{\numberline {\mbox  {IV-D}0a}Dataset~1, multi-seed.}{8}{}\protected@file@percent }
