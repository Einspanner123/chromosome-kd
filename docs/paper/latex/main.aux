\@writefile{lof}{\contentsline {figure}{\numberline {3}{\ignorespaces Entropy phase diagram. Conditional entropy $H(V|Z)$ as a function of the stochastic coupling parameter $\epsilon $. Hard OT ($\epsilon {=}0$) collapses to $H{=}0$; Random coupling ($\epsilon {\to }\infty $) saturates at $H{=}3.8415 \approx \log K{=}3.8427$ (relative error $0.03\%$). Stochastic coupling with $\epsilon \ge 1$ recovers near-full diversity, while $\epsilon < 1$ falls in the danger zone of diversity collapse.}}{4}{}\protected@file@percent }
\newlabel{fig:entropy-phase}{{3}{4}{}{}{}}
\@writefile{lot}{\contentsline {table}{\numberline {II}{\ignorespaces OT Diversity Collapse severity by scenario. OT loss is severe in detection, negligible in image generation.}}{4}{}\protected@file@percent }
