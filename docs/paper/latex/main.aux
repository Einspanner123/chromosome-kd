\@writefile{lot}{\contentsline {table}{\numberline {I}{\ignorespaces Solver$\times $step disentanglement ablation on the A1 checkpoint (24 Chromosomes Object val, seed 42). \emph  {Question:} how much of the A0$\to $A1 gain is RF vs solver/step? \emph  {Conclusion:} solver type is \ensuremath  {\mathrm  {mAP}}{}-neutral at matched steps; the joint solver/step configuration accounts for just $+0.005$ \ensuremath  {\mathrm  {mAP}}{} ($6\%$) of the $+0.082$ gap, leaving $94\%$ attributable to RF.}}{4}{}\protected@file@percent }
\newlabel{tab:solver-ablation}{{I}{4}{}{}{}}
\@writefile{lof}{\contentsline {figure}{\numberline {2}{\ignorespaces Solver$\times $step disentanglement ablation (A1 checkpoint). Bars are colored by solver type and hatched by step count. Solver/step configuration contributes only $+0.005$ \ensuremath  {\mathrm  {mAP}}{} ($6\%$); the remaining $+0.077$ \ensuremath  {\mathrm  {mAP}}{} ($94\%$) is attributable to the RF training paradigm.}}{4}{}\protected@file@percent }
\newlabel{fig:solver-ablation}{{2}{4}{}{}{}}
\@writefile{toc}{\contentsline {subsection}{\numberline {\mbox  {III-C}}OT Diversity Collapse and Stochastic Coupling}{4}{}\protected@file@percent }
