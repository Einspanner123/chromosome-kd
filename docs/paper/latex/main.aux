\@writefile{lot}{\contentsline {table}{\numberline {X}{\ignorespaces FPS / latency benchmark (Dataset~2, 512$\times $512, seed~42). Latency is mean over $200$ images on an RTX A6000 (std $\le 3.4$\,ms, omitted). \emph  {Question:} does the detector reach interactive-screening latency? \emph  {Conclusion:} A3+IO3 K=200 reaches $14.2$ FPS / $70.5$\,ms at \ensuremath  {\mathrm  {mAP}}{} $0.860$, within the interactive band; standard one-shot detectors remain $3$--$7\times $ faster at lower accuracy.}}{9}{}\protected@file@percent }
\newlabel{tab:fps}{{X}{9}{}{}{}}
\@writefile{lof}{\contentsline {figure}{\numberline {7}{\ignorespaces Speed-accuracy trade-off (Dataset~2, RTX A6000, $512{\times }512$). Log-scale FPS axis. Our RF variants (circle/square) occupy the high-accuracy region (\ensuremath  {\mathrm  {mAP}}{} $> 0.85$); standard detectors (triangle) are $3$--$7\times $ faster but less accurate. A3+IO3 K=200 ($14.2$ FPS, \ensuremath  {\mathrm  {mAP}}{} $0.860$) achieves the best speed-accuracy trade-off among our variants.}}{9}{}\protected@file@percent }
\newlabel{fig:fps-map}{{7}{9}{}{}{}}
