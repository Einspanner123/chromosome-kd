\@writefile{lof}{\contentsline {figure}{\numberline {7}{\ignorespaces Qualitative detection comparison (Dataset~2 val, $9$ representative cases). Each column: $3{\times }3$ grid for one model (left to right: GT, KaryoFlow, DiffusionDet, RTMDet-L, DINO R50). Cases cover Y ($1$, $3$), F/G-group ($2$, $7$), D-group ($4$), X ($5$), A-group ($6$, $8$), E16 ($9$). Box colors per-model; in-box labels are predicted classes.}}{9}{}\protected@file@percent }
\newlabel{fig:qual-mosaic}{{7}{9}{}{}{}}
\@writefile{lot}{\contentsline {table}{\numberline {X}{\ignorespaces FPS / latency benchmark (Dataset~2, 512$\times $512, seed~42). Latency is mean over $200$ images on an RTX A6000 (std $\le 3.4$\,ms, omitted). DPM-Solver++ +Top-$K$ (K=200) reaches $14.2$ FPS / $70.5$\,ms at \ensuremath  {\mathrm  {mAP}}{} $0.860$, within the interactive-screening band; single-shot detectors (Cascade R-CNN, YOLOX-S) are $3.6$--$7.4\times $ faster at lower accuracy.}}{9}{}\protected@file@percent }
\newlabel{tab:fps}{{X}{9}{}{}{}}
\@writefile{lof}{\contentsline {figure}{\numberline {8}{\ignorespaces Speed-accuracy trade-off (Dataset~2, RTX A6000, $512{\times }512$). Log-scale FPS axis. Our RF variants (circle/square) occupy the high-accuracy region (\ensuremath  {\mathrm  {mAP}}{} $> 0.85$); single-shot detectors (triangle) trade accuracy for speed. DPM-Solver++ +Top-$K$ (K=200) ($14.2$ FPS, \ensuremath  {\mathrm  {mAP}}{} $0.860$) achieves the best speed-accuracy trade-off among our variants.}}{9}{}\protected@file@percent }
\newlabel{fig:fps-map}{{8}{9}{}{}{}}
\@writefile{lot}{\contentsline {table}{\numberline {XI}{\ignorespaces Annotation-noise robustness (Dataset~2 test, DPM-Solver++, seed~42, $1000$ images). Rows: GT bbox jitter $\sigma _{\text  {bbox}}$ (px); columns: class-flip rate $p$; cells: \ensuremath  {\mathrm  {mAP}}{}@$[0.50{:}0.95]$. Clean baseline: $0.859$. The model stays above the $1/24{\approx }0.042$ chance level even at the heaviest perturbation ($\sigma {=}10$, $p{=}20\%$: \ensuremath  {\mathrm  {mAP}}{}$=0.129$).}}{9}{}\protected@file@percent }
\newlabel{tab:robust-noise}{{XI}{9}{}{}{}}
