\@writefile{lof}{\contentsline {figure}{\numberline {5}{\ignorespaces Training stability (24 Chromosomes Object, real per-epoch mAP from training logs): Random coupling exhibits epoch-level oscillation with std $0.006$, while Stochastic Coupling ($\epsilon {=}5$) converges smoothly with std $0.0013$ ($4.6\times $ improvement). Shaded band marks the last 30 epochs used for std computation.}}{5}{}\protected@file@percent }
\newlabel{fig:training-stability}{{5}{5}{}{}{}}
