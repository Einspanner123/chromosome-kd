\@writefile{lof}{\contentsline {figure}{\numberline {4}{\ignorespaces OT Diversity Collapse. (a) Voronoi partitioning for $K{=}8$ GT boxes in a 2D projection. Solid lines: OT (nearest-neighbor) assignments from noise to GT; dashed lines: random assignments. (b) Empirical validation of Proposition~\ref {prop:ot-gap}: theoretical $\log K = 3.8427$ vs.\ empirical $\Delta H = 3.8415$ (relative error $0.03\%$).}}{5}{}\protected@file@percent }
\newlabel{fig:ot-theory}{{4}{5}{}{}{}}
