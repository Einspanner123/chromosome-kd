\newlabel{tab:solver-ablation}{{I}{3}{}{}{}}
\@writefile{lof}{\contentsline {figure}{\numberline {2}{\ignorespaces Solver$\times $step disentanglement ablation (A1 checkpoint). Bars are colored by solver type and hatched by step count. Solver/step configuration contributes only $+0.005$ \ensuremath  {\mathrm  {mAP}}{} ($6\%$); the remaining $+0.077$ \ensuremath  {\mathrm  {mAP}}{} ($94\%$) is attributable to the RF training paradigm.}}{3}{}\protected@file@percent }
\newlabel{fig:solver-ablation}{{2}{3}{}{}{}}
