\@writefile{lof}{\contentsline {figure}{\numberline {5}{\ignorespaces Training stability (24 Chromosomes Object, real per-epoch mAP from training logs): Random coupling exhibits epoch-level oscillation with std $0.0060$, while Stochastic Coupling ($\epsilon {=}5$) converges smoothly with std $0.0013$ ($4.6\times $ improvement). Shaded band marks the last 30 epochs used for std computation.}}{7}{}\protected@file@percent }
\newlabel{fig:training-stability}{{5}{7}{}{}{}}
\@writefile{lot}{\contentsline {table}{\numberline {VI}{\ignorespaces SOTA comparison on Dataset~2 (independent inference; DPM-Solver++ reports 3-seed mean). RTMDet-L uses a stronger CSPNeXt-L backbone; DINO R50 uses multi-scale deformable attention. Our method is competitive with RTMDet-L on overall \ensuremath  {\mathrm  {mAP}}{} while offering $1.71\times $ fewer NFE; AP$_S$ differences among top methods are not statistically significant (Table~\ref {tab:stat-tests}). The $+0.060$ \ensuremath  {\mathrm  {mAP}}{} gain over DiffusionDet reported in the text uses the seed~42 best checkpoint (\ensuremath  {\mathrm  {mAP}}{} $0.863$); the 3-seed mean ($0.859$) yields $+0.056$. RTMDet-L and DINO R50 values are taken from complete training logs (best checkpoint at epoch~85 and final crashed-state checkpoint respectively).}}{7}{}\protected@file@percent }
\newlabel{tab:sota}{{VI}{7}{}{}{}}
\@writefile{toc}{\contentsline {paragraph}{\numberline {\mbox  {IV-C}0a}Small-object performance}{7}{}\protected@file@percent }
\@writefile{toc}{\contentsline {paragraph}{\numberline {\mbox  {IV-C}0b}Per-class AP analysis}{7}{}\protected@file@percent }
\@writefile{lof}{\contentsline {figure}{\numberline {6}{\ignorespaces Per-class AP on Dataset~2 validation (DPM-Solver++). Bars colored by chromosome size group; dashed line = overall mean. Large (A--C) chromosomes achieve highest AP; small (F--G) and Y lowest. Y is the hardest class due to data scarcity and biological variability.}}{7}{}\protected@file@percent }
\newlabel{fig:per-class}{{6}{7}{}{}{}}
\@writefile{toc}{\contentsline {paragraph}{\numberline {\mbox  {IV-C}0c}Statistical significance of the ablation gains}{7}{}\protected@file@percent }
\@writefile{lot}{\contentsline {table}{\numberline {VII}{\ignorespaces Per-image paired significance tests on Dataset~2 validation ($n{=}500$ images; AP$_S$ uses the $60$ images containing small objects). $\Delta $ is the mean per-image difference of the second model minus the first. Wilc.\ = Wilcoxon signed-rank; $t$ = paired Student's $t$-test. *** denotes $p<0.001$; ns = not significant ($p>0.05$). Stochastic Coupling is not significant on Dataset~2 ($p{=}0.80$; its benefit is confined to Dataset~1, Table~\ref {tab:stat-tests-coupling}); DPM-Solver++ at matched 4-step is highly significant ($+0.006$, $p<10^{-6}$) --- slightly better than Heun; AP$_S$ differences are noise-equivalent.}}{8}{}\protected@file@percent }
\newlabel{tab:stat-tests}{{VII}{8}{}{}{}}
\@writefile{lot}{\contentsline {table}{\numberline {VIII}{\ignorespaces Per-image paired significance tests for the coupling ablation on Dataset~1 (pooled across $3$ training seeds, $n{=}440{\times }3{=}1320$; AP$_S$ uses $1314$ pairs after filtering images without small-object GT). $\Delta $ is the mean per-image difference of the second strategy minus the first. Wilc.\ = Wilcoxon signed-rank; $t$ = paired Student's $t$-test. *** denotes $p<0.001$; * denotes $p<0.05$.}}{8}{}\protected@file@percent }
\newlabel{tab:stat-tests-coupling}{{VIII}{8}{}{}{}}
\newlabel{sec:exp-qual}{{\mbox  {IV-C}1}{8}{}{}{}}
