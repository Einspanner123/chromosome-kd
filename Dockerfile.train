# chromo-train: 精简 GPU 训练镜像
# 使用国内镜像，避免依赖代理
FROM docker.m.daocloud.io/pytorch/pytorch:2.1.0-cuda11.8-cudnn8-runtime

LABEL description="Minimal training image for chromosome-kd (mmdetection)"

# 更换 pip 为清华镜像（国内可直连）
RUN pip config set global.index-url https://pypi.tuna.tsinghua.edu.cn/simple && \
    pip config set global.trusted-host pypi.tuna.tsinghua.edu.cn

# mmcv 2.1.0 — 走清华镜像
RUN pip install --no-cache-dir mmcv==2.1.0 \
    -f https://download.openmmlab.com/mmcv/dist/cu118/torch2.1.0/index.html

# mmengine + 其他 Python 依赖
RUN pip install --no-cache-dir \
    mmengine==0.10.5 \
    timm==1.0.15 \
    pycocotools==2.0.7 \
    scipy \
    shapely \
    tqdm \
    matplotlib \
    tensorboard \
    seaborn \
    scikit-learn

WORKDIR /workspace
